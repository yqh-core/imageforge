# ImageForge - Cloudflare Pages 响应头配置
#
# 这个文件必须位于「部署目录」的根，也就是 build/_headers。
# npm run pack --target=cloudflare 会自动把它放进去，不用手工拷。
#
# Cloudflare Pages 会解析这个文件并把它转成实际响应头，
# 它本身不会被当作静态资源对外提供。
# 上限：100 条规则，单行 2000 字符；匹配到多条规则时取并集。
#
# 本地预览（npm run preview）也会读这个文件并套用同样的头，
# 所以 npm run verify 量到的行为就是线上的行为，不是"本地特供"。

# ---------------------------------------------------------------- 安全响应头
/*
	X-Content-Type-Options: nosniff
	Referrer-Policy: strict-origin-when-cross-origin
	Permissions-Policy: geolocation=(), microphone=(), camera=(self)

	# 强制浏览器此后只用 HTTPS 访问本站（含子域），省掉明文首跳并防降级。
	# 注意：一旦浏览器记住这条，站点必须在 HTTPS 上正常可用，否则会被硬锁。
	# 本项目始终由 Cloudflare 提供 HTTPS，所以是安全的。想回退就改小 max-age。
	Strict-Transport-Security: max-age=31536000; includeSubDomains

	# 内容安全策略：白名单式，默认拒绝所有非同源资源。
	#
	# 这一条是照着实测出来的需要写的，不是抄的模板：
	#   script-src 'self'          —— 没有内联脚本：页面里的内联事件属性
	#                                 （onchange=... 等，js/libs/popup.js）和
	#                                 菜单里的 javascript:void(0) 都已改成
	#                                 事件监听 + href="#"，所以这里不需要
	#                                 'unsafe-inline'，也就不给注入的脚本留口子。
	#   style-src 'self' 'unsafe-inline'
	#                              —— 样式由 style-loader 在运行时注入 <style>，
	#                                 且大量元素的 style 属性是 JS 拼的，必须放开。
	#                                 这一项风险远低于放开 script-src。
	#   img-src ... blob: data:    —— 画布换出图片用 blob:，图标有内联 data:。
	#                                 故意不写 http: —— 页面在 HTTPS 下，明文图片
	#                                 本来就会被浏览器的混合内容规则拦掉。
	#   connect-src 'self' https:  —— 图片搜索（pixabay）与在线字体目录
	#                                 （googleapis）都是 HTTPS 接口。
	#   worker-src 'self' blob:    —— GIF 导出用 blob 构造 Worker。
	#   object-src 'none' / base-uri / form-action
	#                              —— 关掉插件、<base> 劫持、表单外发这三条老路子。
	#
	# 刻意不写 frame-ancestors（等价于不设 X-Frame-Options）：
	# examples/ 里的集成示例需要用 iframe 把本应用嵌进去。
	Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https: blob: data:; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'

# ---------------------------------------------------------------- HTML 必须每次回源校验
# dist/ 的文件名是稳定的（bundle.js），缓存失效靠 index.html 里
# dist/bundle.js?v=<内容指纹> 这个 URL 变化，而不是靠过期时间。
# 所以 index.html 一旦被缓存住，用户就会一直加载指向旧 bundle 的旧页面。
#
# 同时写 "/" 和 "/index.html" 两条：根路径在 Cloudflare 上会被解析到 index.html，
# 但规则是按请求路径匹配的，只写一条在不同的解析时机下可能漏掉，两条都写才稳。
/
	Cache-Control: public, max-age=0, must-revalidate

/index.html
	Cache-Control: public, max-age=0, must-revalidate

# PWA 清单同理：改名/改图标后要及时生效
/manifest.webmanifest
	Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------- Service Worker
# 这一条必须 no-cache，是 PWA 能不能更新的关键。
#
# 浏览器对 service worker 脚本有自己一套缓存逻辑，但发版时我们希望它**立刻**
# 被重新拉取：新 SW 一装上就会检测到 bundle 指纹变了，进而提示用户刷新。
# 如果这里给了长缓存，用户可能几十小时都拿不到新版本，而站点自己以为已经发了。
/service-worker.js
	Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------- 404 页面
# Cloudflare Pages 认根目录下的 404.html 作自定义错误页：存在时未命中路径返回
# 404 状态码 + 这个页面，不存在时统一回落成 200 + index.html（软 404，
# 会被搜索引擎当成一堆内容重复的页面）。所以这个文件必须上线。
/404.html
	Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------- 带内容指纹的构建产物
# URL 上带 ?v=<内容指纹>，内容一变 URL 就变，所以可以永久缓存
/dist/*
	Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------- 图标 / 图片
# 文件名不含指纹，用中等时长。改了 logo / 图标想立刻生效的话，
# 要么改文件名，要么等这个 TTL 过去。
/images/*
	Cache-Control: public, max-age=2592000

# 根目录的 favicon.ico 同理（地址栏、书签、各类爬虫会无条件请求它）
/favicon.ico
	Cache-Control: public, max-age=2592000
